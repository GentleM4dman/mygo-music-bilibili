{
  "id": "bilibili",
  "name": "Bilibili",
  "version": "0.2.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "api.bilibili.com",
      "passport.bilibili.com",
      "s.search.bilibili.com",
      "b23.tv",
      "*.hdslb.com",
      "aisubtitle.hdslb.com"
    ],
    "process": [
      "ffmpeg",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg",
      "C:\\ProgramData\\chocolatey\\lib\\ffmpeg\\tools\\ffmpeg\\bin\\ffmpeg.exe"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "Favorites",
      "builtin": "liked"
    },
    {
      "builtin": "stations"
    }
  ]
}