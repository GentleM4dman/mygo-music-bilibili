{
  "id": "bilibili",
  "name": "Bilibili",
  "version": "0.6.2",
  "minAppVersion": "0.1.21",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "api.bilibili.com",
      "passport.bilibili.com",
      "s.search.bilibili.com",
      "b23.tv",
      "*.bilivideo.com",
      "*.bilivideo.cn",
      "*.hdslb.com",
      "aisubtitle.hdslb.com",
      "www.shitou.club",
      "*.shitou.club",
      "*.xmcdn.com"
    ],
    "process": [
      "ffmpeg",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg"
    ]
  },
  "settings": [
    {
      "key": "savedOrder",
      "label": "Saved Collections order",
      "help": "Folder names, comma-separated, to show first in Saved Collections, in that order. Folders not listed follow in Bilibili's order. Example: 音乐合集, 默认收藏夹",
      "type": "text"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Audiobooks",
      "page": "audiobooks",
      "icon": "playlist"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "Favorites",
      "builtin": "liked"
    },
    {
      "title": "Saved Collections",
      "page": "saved",
      "icon": "album"
    },
    {
      "title": "Following",
      "page": "following",
      "icon": "artist"
    },
    {
      "builtin": "stations"
    }
  ]
}
